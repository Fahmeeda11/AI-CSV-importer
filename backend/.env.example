# --- Backend configuration ---

# Required for AI extraction. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional overrides (defaults shown)
OPENAI_MODEL=gpt-4o-mini
PORT=4000
BATCH_SIZE=20
MAX_FILE_MB=5
AI_CONCURRENCY=4

# CORS: comma-separated origins, or * for any (dev). In prod set your frontend URL.
ALLOWED_ORIGIN=*

NODE_ENV=development
